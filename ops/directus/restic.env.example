# Copiar a /etc/paramoliterario/directus/restic.env con propietario root y modo 0600.
# No guardar valores reales en Git.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/REEMPLAZAR_BUCKET_PRIVADO
RESTIC_PASSWORD_FILE=/etc/paramoliterario/directus/restic_password
AWS_ACCESS_KEY_ID=REEMPLAZAR_CON_KEY_ID_LIMITADA_AL_BUCKET
AWS_SECRET_ACCESS_KEY=REEMPLAZAR_CON_APPLICATION_KEY_LIMITADA_AL_BUCKET
AWS_DEFAULT_REGION=eu-central-003
